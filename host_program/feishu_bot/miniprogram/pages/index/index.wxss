/* CyberWand 控制器 - 样式文件 */

.container {
  padding: 20rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 头部 */
.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4px 20rpx rgba(102, 126, 234, 0.3);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 2px 4rpx rgba(0,0,0,0.2);
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 10rpx;
}

/* 状态卡片 */
.status-card {
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2px 12rpx rgba(0,0,0,0.08);
  transition: all 0.3s;
}

.status-card.connected {
  background: linear-gradient(135deg, #07c160 0%, #10dc60 100%);
}

.status-card.disconnected {
  background: white;
}

.status-row {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}

.status-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  flex: 1;
}

.status-card.connected .status-text {
  color: white;
}

.status-card.disconnected .status-text {
  color: #333;
}

.status-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-right: 10rpx;
}

.status-value {
  font-size: 26rpx;
  color: rgba(255,255,255,0.95);
  font-weight: 500;
}

/* 按钮 */
.action-section {
  margin-bottom: 30rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  box-shadow: 0 2px 8rpx rgba(0,0,0,0.15);
  transition: all 0.2s;
}

.btn:disabled {
  opacity: 0.5;
  box-shadow: none;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.btn-success {
  background: linear-gradient(135deg, #07c160, #10dc60);
  color: white;
}

.btn-secondary {
  background: white;
  color: #666;
}

.btn-block {
  margin-top: 20rpx;
}

/* 区块 */
.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2px 12rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 设备列表 */
.device-list {
  margin-top: 10rpx;
}

.device-item {
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s;
}

.device-item.selected {
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102,126,234,0.05), rgba(118,75,162,0.05));
}

.device-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.device-id {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
  margin-bottom: 8rpx;
}

.device-rssi {
  font-size: 22rpx;
  color: #666;
}

/* 动作映射 */
.mapping-list {
  margin-top: 10rpx;
}

.mapping-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.mapping-item:last-child {
  border-bottom: none;
}

.mapping-left {
  flex: 1;
}

.mapping-action {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.mapping-desc {
  font-size: 24rpx;
  color: #999;
}

.mapping-input {
  width: 140rpx;
  height: 64rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  text-align: center;
  background: #fafafa;
}

/* 参数滑块 */
.param-item {
  margin-bottom: 30rpx;
}

.param-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.param-value {
  font-weight: 600;
  color: #667eea;
}

slider {
  width: 100%;
}

/* 传感器卡片 */
.sensor-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.sensor-row {
  display: flex;
  margin-bottom: 16rpx;
}

.sensor-row:last-child {
  margin-bottom: 0;
}

.sensor-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  width: 160rpx;
  flex-shrink: 0;
}

.sensor-value {
  font-size: 26rpx;
  color: white;
  font-family: monospace;
  flex: 1;
}

/* 帮助信息 */
.help-section {
  background: linear-gradient(135deg, rgba(102,126,234,0.05), rgba(118,75,162,0.05));
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.help-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.help-list {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.help-item {
  margin-bottom: 10rpx;
  padding-left: 20rpx;
  position: relative;
}

.help-item::before {
  content: '•';
  position: absolute;
  left: 0;
  color: #667eea;
  font-weight: bold;
}
